PORT=4000

# 허용할 프론트 주소 (쉼표로 여러 개 가능)
CORS_ORIGIN=http://localhost:5173

# Supabase (service role 키는 절대 프론트/깃에 노출 금지)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Storage 버킷 이름
FRAMES_BUCKET=frames
RESULTS_BUCKET=results

# 메일 (SMTP) - 로컬 개발은 Gmail 앱 비밀번호로 가능
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="js4cut <your@gmail.com>"
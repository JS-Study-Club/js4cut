PORT=4000

# 허용할 프론트 주소 (쉼표로 여러 개 가능)
CORS_ORIGIN=http://localhost:5173

# Supabase (service role 키는 절대 프론트/깃에 노출 금지)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Storage 버킷 이름
FRAMES_BUCKET=frames
RESULTS_BUCKET=results

# 메일 (Gmail API, OAuth) - Render 무료 플랜은 SMTP가 막혀 있어 HTTPS API 사용
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

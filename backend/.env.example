PORT=4000

# 허용할 프론트 주소 (쉼표로 여러 개 가능)
CORS_ORIGIN=http://localhost:5173

# Supabase (service role 키는 절대 프론트/깃에 노출 금지)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Storage 버킷 이름
FRAMES_BUCKET=frames
RESULTS_BUCKET=results

# 메일 (Resend, https://resend.com) - 도메인 인증 전에는 가입한 본인 이메일로만 발송 가능
RESEND_API_KEY=
MAIL_FROM="js4cut <onboarding@resend.dev>"
